{
	"name": "flarum-lang/indonesian",
	"description": "Indonesian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/indonesian",
	"license": "MIT",
	"authors": [
		{
			"name": "realodix",
			"homepage": "https://github.com/realodix",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/indonesian/issues",
		"forum": "https://discuss.flarum.org/d/1358",
		"source": "https://github.com/flarum-lang/indonesian"
	},
	"require": {
		"flarum/core": "^1.7"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Indonesian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "id",
			"title": "Bahasa Indonesia"
		}
	}
